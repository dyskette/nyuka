{
  "name": "nyuka-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && lingui compile && vite build",
    "preview": "vite preview",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript openapi.json -o src/shared/api/schema.d.ts",
    "i18n:extract": "lingui extract",
    "i18n:check": "lingui extract --clean && git diff --exit-code src/shared/i18n/catalogs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deadcode": "knip",
    "size": "size-limit"
  },
  "dependencies": {
    "@lingui/core": "6.7.0",
    "@lingui/react": "6.7.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.13",
    "cmdk": "1.1.1",
    "lucide-react": "1.47.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@lingui/cli": "6.7.0",
    "@lingui/format-po": "^6.7.0",
    "@lingui/vite-plugin": "6.7.0",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@size-limit/preset-app": "^14.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-devtools": "1.167.2",
    "@tanstack/router-plugin": "1.168.40",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "30.1.1",
    "knip": "6.37.0",
    "msw": "2.15.0",
    "openapi-msw": "2.0.0",
    "openapi-typescript": "7.13.0",
    "size-limit": "14.0.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "size-limit": [
    {
      "name": "main chunk",
      "path": "dist/assets/index-*.js",
      "limit": "220 kB"
    }
  ]
}
