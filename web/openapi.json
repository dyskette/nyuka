        "responses": {
          "200": {
            "description": "Added, or already present",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MangaDto"
                }
              }
            }
          },
          "404": {
            "description": "No such source or series"
          },
          "502": {
            "description": "The source could not be reached"
          }
        }
      }
    },
