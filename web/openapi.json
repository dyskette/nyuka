              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Paged_FollowDto"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "follows"
        ],
        "summary": "`PUT /api/v1/follows` — follow a series, or change how it is followed.",
        "description": "`PUT` rather than `POST` because the operation is keyed on `manga_id` and\nis idempotent: following an already-followed series updates it instead of\ncreating a second follow, which is what a user pressing the button twice\nexpects.",
        "operationId": "upsert",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FollowRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FollowDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid interval"
          },
          "404": {
            "description": "No such series"
          }
        }
      }
    },
