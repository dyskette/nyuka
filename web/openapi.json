  "components": {
    "schemas": {
      "AddRequest": {
        "type": "object",
        "required": [
          "source_id",
          "external_key"
        ],
        "properties": {
          "external_key": {
            "type": "string"
          },
          "source_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CatalogItemDto": {
        "type": "object",
        "description": "A catalog result, which has no local identity.",
        "required": [
          "external_key",
          "title",
          "authors",
          "artists",
          "tags",
          "status",
          "content_rating",
          "reading_direction"
        ],
        "properties": {
          "artists": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "content_rating": {
            "type": "string"
          },
          "cover_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "external_key": {
            "type": "string",
            "description": "The source's own key. This, plus the source id, is how it is added."
          },
          "manga_id": {
            "type": [
              "string",
              "null"
