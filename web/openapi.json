{
  "openapi": "3.1.0",
  "info": {
    "title": "nyuka",
    "description": "A self-hosted manga library server.",
    "license": {
      "name": "AGPL-3.0-or-later"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/chapters/{id}": {
      "get": {
        "tags": [
          "library"
        ],
        "summary": "`GET /api/v1/chapters/{id}`",
        "operationId": "chapter",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Chapter id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChapterDto"
                }
              }
            }
          },
          "404": {
            "description": "No such chapter"
          }
        }
      }
    },
    "/downloads": {
      "post": {
        "tags": [
          "downloads"
        ],
        "summary": "`POST /api/v1/downloads`",
        "description": "Returns `202` with a `Location` pointing at the job. The work is a series\nof requests to a third-party site; doing it inline would hold a connection\nopen for minutes.\n\nIdempotent on the chapter, so a double-click queues one download. An\n`Idempotency-Key` header is accepted and narrows that further, which is\nwhat makes a retried request from a flaky network safe.",
        "operationId": "request",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DownloadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Queued; `Location` names the job"
          },
          "404": {
            "description": "No such chapter"
          },
          "409": {
            "description": "Already in the library"
          }
        }
      }
    },
    "/downloads/{chapter_id}/file": {
      "get": {
        "tags": [
          "downloads"
        ],
        "summary": "`GET /api/v1/downloads/{chapter_id}/file`",
        "operationId": "file",
        "parameters": [
          {
            "name": "chapter_id",
            "in": "path",
            "description": "Chapter id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The CBZ",
            "content": {
              "application/vnd.comicbook+zip": {}
            }
          },
          "206": {
            "description": "The requested range"
          },
          "304": {
            "description": "The ETag matched"
          },
          "404": {
            "description": "Not downloaded"
          },
          "416": {
            "description": "The range is outside the file"
          }
        }
      }
    },
    "/follows": {
      "get": {
        "tags": [
          "follows"
        ],
        "summary": "`GET /api/v1/follows`",
        "operationId": "list",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "description": "The `next_cursor` from a previous page.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
