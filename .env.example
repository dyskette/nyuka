# Copy to .env for local development. Secrets come from Docker secrets or a
# vault in production and never live in the image.

# --- Core --------------------------------------------------------------------
DATABASE_URL=postgres://nyuka:nyuka@localhost:5432/nyuka
BIND_ADDR=0.0.0.0:8080
DATA_DIR=/data
LIBRARY_ROOT=/library

# --- Auth (ADR-0005) ---------------------------------------------------------
# `oidc` (default) or `none`.
#
# `none` serves every request as a single seeded local user: no identity
# provider, no client secret, no allow-list. Nothing below this line is read.
# Intended for a barebones self-host on a machine only you can reach — the
# library is shared either way, so authentication is about who can reach the
# server, not about separating anyone's data.
#
# Explicit on purpose: a typo in OIDC_ISSUER_URL fails the boot rather than
# silently serving an open instance.
#
# WARNING: with `none`, anyone who can reach the port can install sources,
# which makes this server fetch and execute third-party WebAssembly. Keep it
# on loopback, behind a VPN, or behind an authenticating proxy.
AUTH_MODE=oidc

OIDC_ISSUER_URL=https://auth.example.com
OIDC_CLIENT_ID=nyuka
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=https://nyuka.example.com/api/v1/auth/callback
# Fail-closed: empty denies everyone rather than admitting everyone.
AUTH_ALLOWED_SUBJECTS=
AUTH_ALLOWED_GROUPS=
# Required with AUTH_MODE=oidc: `openssl rand -hex 64`.
# With AUTH_MODE=none it is optional, and one is generated per run — sessions
# then carry nothing that needs to survive a restart.
SESSION_KEY=
SESSION_TTL_HOURS=720

# --- Jobs (ADR-0003) ---------------------------------------------------------
JOB_WORKERS=4
JOB_POLL_INTERVAL_MS=1000
# Ceiling only. A source's own net::set_rate_limit is honoured when stricter
# (ADR-0004).
SOURCE_MAX_CONCURRENCY=4
JOB_STALE_LOCK_SECS=900
JOB_RETENTION_DAYS=30

# --- Sources (ADR-0004) ------------------------------------------------------
FLARESOLVERR_URL=http://flaresolverr:8191
WASM_MAX_MEMORY_MB=128
WASM_EPOCH_TIMEOUT_MS=30000

# --- Observability (ADR-0014) ------------------------------------------------
RUST_LOG=info,nyuka_api=debug,sea_orm=warn,sqlx=warn,hyper=warn
# Only `json` is implemented: log redaction parses each line as JSON.
LOG_FORMAT=json
OTEL_SERVICE_NAME=nyuka-api
DB_SLOW_STATEMENT_MS=250
# Only has an effect when built with --features otlp. Logs are never sampled.
# OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

# --- Frontend telemetry ingest (ADR-0013) ------------------------------------
TELEMETRY_INGEST_ENABLED=true
TELEMETRY_INGEST_MAX_BODY_BYTES=262144

# --- Proxy -------------------------------------------------------------------
# CIDRs permitted to set X-Forwarded-*. Governs client address only: identity
# is never taken from a proxy header (ADR-0005).
TRUSTED_PROXIES=
